{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-sonnet-5",
  "autoupdate": true,
  "agents": {
    "fast": {
      "description": "Fast-tier subagent for simple, low-risk planner steps (tier: fast).",
      "mode": "subagent",
      "model": "opencode/claude-haiku-5-5"
    },
    "standard": {
      "description": "Standard-tier subagent for most planner steps (tier: standard).",
      "mode": "subagent",
      "model": "opencode/claude-sonnet-5-5"
    },
    "deep": {
      "description": "Deep-tier subagent for ambiguous, multi-file or high-risk planner steps (tier: deep).",
      "mode": "subagent",
      "model": "opencode/claude-opus-5-5"
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-linear"],
      "environment": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      }
    },
    "slack": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-slack"],
      "environment": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-notion"],
      "environment": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      }
    },
    "helpscout": {
      "type": "local",
      "command": ["npx", "-y", "help-scout-mcp-server"],
      "environment": {
        "HELPSCOUT_API_KEY": "${HELPSCOUT_API_KEY}"
      }
    }
  },
  "plugin": ["@warp-dot-dev/opencode-warp"]
}
